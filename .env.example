# Copy to .env and fill in the keys you have. Never commit .env.
# A demo skips any model whose key is empty.

JEV_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Model IDs (change here if a vendor renames a model)
JEV_MODEL=jev-latest
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-6-astra
XAI_MODEL=grok-4.7

# Project 1 router: which LLM gets the medium-confidence cases and which gets the hard ones
ROUTE_CHEAP=grok
ROUTE_STRONG=opus
# Jev confidence at or above ACT: use Jev's answer. Between ESCALATE and ACT: cheap model. Below ESCALATE: strong model.
ROUTE_ACT=0.8
ROUTE_ESCALATE=0.5

# How many dataset items to run (all = leave empty). Use a small number in class.
SAMPLE=

# Level 3 (Grafana stack): uncomment after `npm run obs:up`
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=jev-training

# Spending cap: at most this many USD per model, per run (one npm command).
BUDGET_USD_PER_MODEL=5

# Claude thinking effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# Project 2 bands on Jev's "looks broken" probability
EXPLORE_CLEAR=0.4
EXPLORE_FLAG=0.7

# Project 1: also ask every other LLM alone, for the per-LLM comparison (false = faster, cheaper)
COMPARE_ALL_LLMS=true
